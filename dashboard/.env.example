# Copy to `.env` in this folder for local development. Never commit real values.

# Supabase (optional — without these, the UI uses built-in demo price data)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Edge functions base URL, e.g. https://<project-ref>.supabase.co/functions/v1
VITE_FUNCTION_BASE=

# PostHog (optional — omit both to disable analytics)
VITE_POSTHOG_KEY=
# VITE_POSTHOG_HOST=https://us.i.posthog.com
